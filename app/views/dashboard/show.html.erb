<%= turbo_stream_from "dvf_imports" %>

<div class="app">
  <aside class="sidebar" data-controller="sidebar" data-action="map:pick@window->sidebar#pick">
    <header class="masthead">
      <p class="masthead__edition">
        <span>N° <%= Date.current.year %></span>
        <span>
          <% if @last_done&.data_until %>
            <%= l @last_done.data_from, format: "%-d %b %Y" %> → <%= l @last_done.data_until, format: "%-d %b %Y" %>
          <% else %>
            Aucune vente chargée
          <% end %>
        </span>
      </p>
      <h1 class="masthead__title">Pierres <em>de</em> Paris</h1>
      <p class="masthead__tagline">Chronique des ventes immobilières, arrondissement par arrondissement — et aux portes de Paris.</p>
    </header>

    <%= turbo_frame_tag "stats", class: "stats-frame" do %>
      <%= render "dashboard/paris_stats", paris: @paris %>
    <% end %>

    <nav class="summary" aria-label="Arrondissements">
      <h3 class="summary__heading"><span>Sommaire</span><span>€/m² médian</span></h3>
      <ol class="summary__list">
        <%= render partial: "dashboard/row", collection: @arrondissements, as: :arr, locals: { max_median: @max_median } %>
      </ol>

      <h3 class="summary__heading summary__heading--sub"><span>Aux portes de Paris</span><span>Hauts-de-Seine</span></h3>
      <ol class="summary__list">
        <%= render partial: "dashboard/row", collection: @communes, as: :arr, locals: { max_median: @max_median } %>
      </ol>
    </nav>

    <footer class="colophon" data-controller="import">
      <%= render "dvf_imports/status", import: @import %>
      <%= button_to "Rafraîchir les données", dvf_imports_path, class: "refresh-btn",
                    form: { data: { action: "turbo:submit-start->import#start" } },
                    data: { import_target: "button" } %>
      <p class="colophon__source">
        Source : <a href="https://www.data.gouv.fr/fr/datasets/demandes-de-valeurs-foncieres-geolocalisees/" target="_blank" rel="noopener">DVF géolocalisées</a>, Etalab · Contours : Ville de Paris
      </p>
    </footer>
  </aside>

  <section class="map-panel">
    <div class="map" data-controller="map"
         data-map-sales-url-value="<%= sales_path(format: :json) %>"
         data-map-contours-url-value="<%= arrondissements_path(format: :json) %>"
         data-action="arrondissement:select@window->map#focus arrondissement:reset@window->map#reset"></div>

    <div class="legend" aria-hidden="true">
      <p class="legend__title">Prix au m²</p>
      <div class="legend__scale"></div>
      <div class="legend__labels"><span>7 k€</span><span>10 k€</span><span>13 k€</span><span>16 k€+</span></div>
      <p class="legend__note">Un point = une vente</p>
    </div>
  </section>
</div>
